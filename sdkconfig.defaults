# CDC Badge OS v0.5 - Minimal sdkconfig for initial build

# Main task needs larger stack for crypto + WiFi operations
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_FREERTOS_HZ=1000

# Per-task run-time counters for on-demand CPU-load read-out (esp_timer source).
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Flash configuration
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# FATFS volume label support (f_getlabel/f_setlabel) so the vfat volume can be
# named CDCBADGE instead of the fatfsgen default.
CONFIG_FATFS_USE_LABEL=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=n

# PSRAM (SPIRAM) configuration
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# TinyUSB mode: Disable USB-Serial-JTAG (mutually exclusive with TinyUSB)
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=n

# USB Early Debug Mode
# Enable for development: USB starts early, provides boot logs, but requires replug after boot.
# Disable for production: USB starts after all modules loaded, clean enumeration.
CONFIG_USB_EARLY_DEBUG=y

# UART0 for early boot logs (before TinyUSB init)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Disable OpenThread (not needed)
CONFIG_OPENTHREAD_ENABLED=n

# Bluetooth (NimBLE) enabled
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y

# WiFi enabled
CONFIG_ESP_WIFI_ENABLED=y

# WiFi buffer configuration (from legacy)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# WiFi/BT coexistence
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# HTTPS client support (required by mod_homeassistant once activated).
# Cert validation is NOT performed at runtime - the RAM and rodata of a CA
# bundle would not fit, and the typical HA setup is a private LAN endpoint.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# SNTP: allow a primary plus two fallback time servers.
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# RTC slow clock: no external 32 kHz crystal on the board. The default 136 kHz
# RC oscillator drifts heavily with temperature, and the badge spends most of
# its life in light sleep where elapsed time is derived from this clock.
# RC_FAST/256 (~68 kHz) is far more temperature-stable at a few uA extra sleep
# current. More calibration cycles at boot improve the initial estimate.
CONFIG_RTC_CLK_SRC_INT_8MD256=y
CONFIG_ESP32S3_RTC_CLK_SRC_INT_8MD256=y
CONFIG_RTC_CLK_CAL_CYCLES=3000

# System event loop needs more stack for logging in event handlers
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Core dump to flash for crash analysis
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# Security
CONFIG_SECURE_SERIAL=y

# E-Paper Display Pins (GDEY029T94)
CONFIG_EINK_SPI_MOSI=13
CONFIG_EINK_SPI_CLK=12
CONFIG_EINK_SPI_CS=41
CONFIG_EINK_DC=45
CONFIG_EINK_RST=46
CONFIG_EINK_BUSY=42
CONFIG_EINK_SPI_MISO=11
