#pragma once

/**
 * \file
 * \brief Template for a custom TROPIC01 SH0 pairing key.
 *
 * Copy this file to "pairing_key_custom.h" (same directory, git-ignored), fill
 * in the 32-byte X25519 SH0 private/public key of the slot your chip is
 * provisioned with, then build with:
 *   -DCDC_PAIRING_KEY=CDC_PAIRING_KEY_CUSTOM
 *
 * The keys are linked into a single translation unit; keep them `static const`.
 * Never commit a real key.
 */

#include <stdint.h>

#include "libtropic_common.h"

static const uint8_t cdc_pairing_key_priv[32] = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
};

static const uint8_t cdc_pairing_key_pub[32] = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
};

/* Pairing-key slot the custom key occupies (0..3). */
#define CDC_PAIRING_KEY_SLOT TR01_PAIRING_KEY_SLOT_INDEX_0
